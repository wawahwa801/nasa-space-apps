# Copy to backend/.env and fill in. Never commit .env.

# Registered provider name. "mock" returns canned output without network calls.
LLM_PROVIDER=mock
# Model identifier passed to the provider.
LLM_MODEL=
# Provider API key.
LLM_API_KEY=
# Optional custom endpoint for providers that support one.
LLM_BASE_URL=

LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
# Largest serialized data payload (in characters) accepted per request.
LLM_MAX_INPUT_CHARS=50000
