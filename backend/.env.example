# Template only: copy to backend/.env for local use and fill in your own values.
# backend/.env is gitignored. Never commit a real key, and never put it in frontend
# code or a NEXT_PUBLIC_* variable.
#
# On Vercel, set these under Project Settings -> Environment Variables instead
# (mark LLM_API_KEY as Sensitive), then redeploy. See deploy/README.md.

# AI insights provider. Leave LLM_PROVIDER as "mock" to work offline.
LLM_PROVIDER=openrouter
LLM_MODEL=dots-studio/dots-3-note-preview:free
LLM_API_KEY=

# Optional limits.
# LLM_MAX_OUTPUT_TOKENS=1024
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_INPUT_CHARS=50000

# Public-site protection for /api/analyze and /api/safety-insights.
# On by default when running on Vercel; off for local development.
# LLM_ALLOWED_ORIGINS=https://your-custom-domain.example
# LLM_REQUIRE_ORIGIN=true
# LLM_RATE_LIMIT_PER_MINUTE=6
# LLM_RATE_LIMIT_PER_DAY=100
# LLM_GLOBAL_LIMIT_PER_MINUTE=30
