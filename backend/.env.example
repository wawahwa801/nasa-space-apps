# Copy to backend/.env. Never commit backend/.env or real credentials.
# Use a PostgreSQL LOGIN granted membership in pyroclast_model_reader.
# Percent-encode special characters in the username/password.
# For a remote database, use sslmode=verify-full with the provider's CA certificate.
DATABASE_URL=postgresql://your_app_login:YOUR_PASSWORD@localhost:5432/pyroclast

# Existing analysis routes can run without a paid provider.
LLM_PROVIDER=mock
