# Copy to backend/.env. Never commit backend/.env or real credentials.
# Use a PostgreSQL LOGIN granted membership in pyroclast_model_reader.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pyroclast
DB_USER=your_app_login
DB_PASSWORD=YOUR_PASSWORD
# Optional verified TLS for a remote database:
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/path/to/provider-ca.pem

# Existing analysis routes can run without a paid provider.
LLM_PROVIDER=mock

# Registry entry for the full hybrid bundle (not the feature-only selected.pt).
HYBRID_MODEL_NAME=flex2-hybrid
HYBRID_S3_BUCKET=YOUR_PRIVATE_BUCKET
HYBRID_S3_PREFIX=models/flex2-hybrid/
AWS_REGION=us-west-2
# Optional; defaults to backend/.model-cache, ignored by Git.
# MODEL_CACHE_DIR=/var/cache/pyroclast/models
# Use your local AWS login/profile or an EC2 instance role. No AWS keys here.
