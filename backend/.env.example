# Copy to backend/.env. Never commit backend/.env or real credentials.
# Use a PostgreSQL LOGIN granted membership in pyroclast_model_reader.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pyroclast
DB_USER=your_app_login
DB_PASSWORD=YOUR_PASSWORD
# Optional verified TLS for a remote database:
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/path/to/provider-ca.pem

# Existing analysis routes can run without a paid provider.
LLM_PROVIDER=mock
